[
 {
  "id": "M580D/2/0002",
  "kind": "msg",
  "jp": "天邪鬼が　あらわれた！\n　{KP}\n「ヘイ！　ヘイ！　桃太郎！\n　簡単すぎる問題に　答えてみろよ！」",
  "en": "Amanojaku appeared!{KP}\"Hey! Hey! Momotaro! Let's see you answer some way-too-easy questions!\""
 },
 {
  "id": "M580D/3/000A",
  "kind": "msg",
  "jp": "「ヘイ！　ヘイ！\n　こんな　問題も　解けないのか！」{KP}\n「常識が　ないやつが\n　大金うばわれても　仕方ないな！」",
  "en": "\"Hey! Hey! You can't even solve this one?!\"{KP}\"Anyone with no common sense deserves to get robbed blind!\""
 },
 {
  "id": "M580D/3/0090",
  "kind": "msg",
  "jp": "「ヘイ！　ヘイ！\n　１両も　持っていないのか！」{KP}\n「あの桃太郎が\n　一文無しだとはな！」{KP}\n桃太郎は\nお金を　とられずに　すんだ！{KP}\nでも　ちょっと　くやしい！\n　",
  "en": "\"Hey! Hey! You don't have a single ryo?!\"{KP}\"The great Momotaro, flat broke!\"{KP}Momotaro got to keep his money!{KP}But it still stings a little!"
 },
 {
  "id": "M580D/3/0164",
  "kind": "msg",
  "jp": "天邪鬼は\n{R1}両　うばって行った！",
  "en": "Amanojaku took {R1} ryo!"
 },
 {
  "id": "M580D/3/0196",
  "kind": "msg",
  "jp": "「ヘイ！　ヘイ！　これで\n　勇気の剣でも　買いな！」",
  "en": "\"Hey! Hey! Go buy yourself a Sword of Courage with this!\""
 },
 {
  "id": "M580D/3/01E8",
  "kind": "msg",
  "jp": "天邪鬼は　わずか　{R0}両\nおいていった！　なんだ　あいつは！",
  "en": "Amanojaku left a measly {R0} ryo! What's with that guy?!"
 },
