[
 {
  "id": "M580D/2/0002",
  "kind": "msg",
  "jp": "天邪鬼が　あらわれた！\n　{KP}\n「ヘイ！　ヘイ！　桃太郎！\n　簡単すぎる問題に　答えてみろよ！」",
  "en": ""
 },
 {
  "id": "M580D/3/000A",
  "kind": "msg",
  "jp": "「ヘイ！　ヘイ！\n　こんな　問題も　解けないのか！」{KP}\n「常識が　ないやつが\n　大金うばわれても　仕方ないな！」",
  "en": ""
 },
 {
  "id": "M580D/3/0090",
  "kind": "msg",
  "jp": "「ヘイ！　ヘイ！\n　１両も　持っていないのか！」{KP}\n「あの桃太郎が\n　一文無しだとはな！」{KP}\n桃太郎は\nお金を　とられずに　すんだ！{KP}\nでも　ちょっと　くやしい！\n　",
  "en": ""
 },
 {
  "id": "M580D/3/0164",
  "kind": "msg",
  "jp": "天邪鬼は\n{R1}両　うばって行った！",
  "en": ""
 },
 {
  "id": "M580D/3/0196",
  "kind": "msg",
  "jp": "「ヘイ！　ヘイ！　これで\n　勇気の剣でも　買いな！」",
  "en": ""
 },
 {
  "id": "M580D/3/01E8",
  "kind": "msg",
  "jp": "天邪鬼は　わずか　{R0}両\nおいていった！　なんだ　あいつは！",
  "en": ""
 },
