[
 {
  "id": "M530D/3/0002",
  "kind": "msg",
  "jp": "算数の鬼が　あらわれた！\n　{KP}\n「＋＋－－ｘｘ÷÷！\n　答え一発！　問題を　解いてみろ！」",
  "en": "The Math Oni appeared!{KP}\"Plus! Minus! Times! Divide! One shot at the answer! Try and solve this problem!\""
 },
 {
  "id": "M530D/4/0012",
  "kind": "msg",
  "jp": "「正解！　正解！\n　賞金{R0}両　ですぞい！」",
  "en": "\"Correct! Correct! Your prize is {R0} ryo, zoi!\""
 },
 {
  "id": "M530D/4/005A",
  "kind": "msg",
  "jp": "算数の鬼は\n{R0}両　置いていった！",
  "en": "The Math Oni left {R0} ryo behind!"
 },
 {
  "id": "M530D/4/008C",
  "kind": "msg",
  "jp": "「ち　ち　ちがーーーーーう！\n　{R0}が　正解ですぞーい！」{KP}\n算数の鬼は　去っていった！\n　",
  "en": "\"Wr-wr-wrooooong! The answer was {R0}, zoi!\"{KP}The Math Oni left!"
 },
 {
  "id": "M530D/5/0002",
  "kind": "msg",
  "jp": "「時間切れですぞーい！」\n　{KP}\n「待ちくたびれましたぞーい！」\n　{KP}\n「帰りますぞーーーい！」\n　{KP}\n算数の鬼は　去っていった！\n　",
  "en": "\"Time's up, zoi!\"{KP}\"I'm worn out from waiting, zoi!\"{KP}\"I'm going home, zoiii!\"{KP}The Math Oni left!"
 },
